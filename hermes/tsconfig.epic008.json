{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "lib": ["ES2022", "DOM"],
    "types": ["node"]
  },
  "include": [
    "services/activation/providers/deployment/**/*.ts",
    "services/activation/providers/cloudflare/**/*.ts",
    "services/activation/providers/github/**/*.ts",
    "services/activation/providers/secret-source.ts",
    "services/activation/providers/bootstrap.ts",
    "services/activation/provider-framework.ts"
  ],
  "exclude": [
    "**/__tests__/**"
  ]
}
