{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "agsynergy-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-17",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agsynergy-db",
      "database_id": "45f52102-74e1-4ba2-86ca-f4d5f88e16c4"
    }
  ],
  "vars": {
    "ENVIRONMENT": "development",
    "RATE_LIMIT_WINDOW_MS": "60000",
    "RATE_LIMIT_LIMIT": "60"
  },
  "env": {
    "production": {
      "routes": [
        {
          "pattern": "api.agsynergy.ca",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agsynergy-db",
          "database_id": "45f52102-74e1-4ba2-86ca-f4d5f88e16c4"
        }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "ENVIRONMENT": "production",
        "RATE_LIMIT_WINDOW_MS": "60000",
        "RATE_LIMIT_LIMIT": "60"
      }
    },
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agsynergy-db",
          "database_id": "45f52102-74e1-4ba2-86ca-f4d5f88e16c4"
        }
      ],
      "observability": {
        "enabled": true
      },
      "vars": {
        "ENVIRONMENT": "preview",
        "RATE_LIMIT_WINDOW_MS": "60000",
        "RATE_LIMIT_LIMIT": "60"
      }
    }
  },
  "workers_dev": true,
  "alias": {
    "@hermes": "../hermes",
    "@shared": "../shared"
  }
}
